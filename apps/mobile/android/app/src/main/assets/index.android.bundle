                ${Z}\n                <div>\n                  <div style="font-size: 16px; font-weight: 900; color: #0f172a; text-transform: uppercase; line-height: 1.1;">${X}</div>\n                  <div style="font-size: 10px; color: #475569; font-weight: 500;">${Y}</div>\n                  <div style="font-size: 9px; color: #64748b;">${K?`CNPJ: ${K} | `:''}${ee?`Tel: ${ee}`:''}${te?` | ${te}`:''}</div>\n                  <div style="font-size: 9px; color: #64748b;">${ne}</div>\n                </div>\n              </div>\n              <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0;">\n                <span style="background: #dcfce7; color: #166534; border: 1px solid #86efac; font-size: 9px; font-weight: 900; text-transform: uppercase; padding: 2px 8px; border-radius: 4px; margin-bottom: 2px;">COMPROVANTE DE ENTRADA \u2022 VIA DO CLIENTE</span>\n                <div style="font-size: 18px; font-weight: 900; color: #0f172a; font-family: monospace; line-height: 1.1;">${je}</div>\n                <div style="font-size: 9.5px; font-weight: bold; color: #334155;">ENTRADA: ${le}</div>\n                <div style="font-size: 8.5px; font-weight: 600; color: #64748b;">EMISS\xc3O: ${J}</div>\n              </div>\n            </div>\n\n            \x3c!-- DADOS DO CLIENTE & EQUIPAMENTO --\x3e\n            <div class="grid-2">\n              <div class="box">\n                <div class="box-title">Dados do Cliente</div>\n                <div><strong>Nome:</strong> ${oe.name||'N\xe3o informado'}</div>\n                <div><strong>Endere\xe7o:</strong> ${oe.address?`${oe.address}${oe.number?`, ${oe.number}`:''}`:'Endere\xe7o n\xe3o informado'}</div>\n                <div><strong>Bairro:</strong> ${oe.neighborhood||''} ${oe.city?`| Cidade/UF: ${oe.city}/${oe.state||''}`:''}</div>\n                ${oe.complement?`<div><strong>Complemento:</strong> ${oe.complement}</div>`:''}\n                ${oe.reference?`<div><strong>Refer\xeancia:</strong> ${oe.reference}</div>`:''}\n                <div><strong>Telefone:</strong> ${oe.phone||''} ${oe.whatsapp?`| WhatsApp: ${oe.whatsapp}`:''}</div>\n              </div>\n              <div class="box">\n                <div class="box-title">Dados do Aparelho / Equipamento</div>\n                <div><strong>Equipamento:</strong> ${ie.type||'Equipamento Geral'}</div>\n                <div><strong>Marca:</strong> ${ie.brand||'N/A'} ${ie.model?`| <strong>Modelo:</strong> ${ie.model}`:''}</div>\n                <div><strong>N\xba de S\xe9rie:</strong> ${ie.serialNumber||'N/A'}</div>\n                <div><strong>Acess\xf3rios:</strong> ${ie.accessories||'Nenhum'}</div>\n              </div>\n            </div>\n\n            \x3c!-- RESPONS\xc1VEIS E DADOS DE GARANTIA / NOTA FISCAL --\x3e\n            <div class="grid-2">\n              <div style="background: rgba(240, 249, 255, 0.7); padding: 8px 10px; border-radius: 8px; border: 1px solid #bae6fd;">\n                <span style="font-weight: bold; color: #082f49; text-transform: uppercase; font-size: 9px; display: block; border-bottom: 1px solid #bae6fd; padding-bottom: 2px; margin-bottom: 3px;">Respons\xe1veis pelo Atendimento:</span>\n                <div style="font-size: 9.5px; color: #1e293b;">\n                  <div><strong>Atendente:</strong> ${re||'N\xe3o informado'}</div>\n                  ${ae?`<div><strong>T\xe9cnico:</strong> ${ae}</div>`:''}\n                </div>\n              </div>\n              <div class="box">\n                <div class="box-title">Garantia / Nota Fiscal</div>\n                ${'GARANTIA_FABRICA'===pe?`\n                  <div style="font-size: 9.5px; color: #334155;">\n                    <div><strong>Garantia:</strong> Fabricante</div>\n                    <div><strong>NF:</strong> ${be.nfNumber||'-'} | <strong>Compra:</strong> ${be.purchaseDate?new Date(be.purchaseDate).toLocaleDateString('pt-BR'):'-'}</div>\n                    <div><stro