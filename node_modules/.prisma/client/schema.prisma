generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Client {
  id            String         @id @default(uuid())
  name          String
  phone         String
  email         String?
  cep           String
  address       String
  number        String
  neighborhood  String
  city          String
  state         String
  createdAt     DateTime       @default(now())
  serviceOrders ServiceOrder[]
}

model Equipment {
  id            String         @id @default(uuid())
  type          String
  brand         String
  model         String
  serialNumber  String?
  serviceOrders ServiceOrder[]
}

model ServiceOrder {
  id                 String    @id @default(uuid())
  code               String    @unique
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  equipmentId        String
  equipment          Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  problemDescription String
  status             String    @default("ABERTA") // ABERTA, EM_ATENDIMENTO, AGUARDANDO_APROVACAO, FINALIZADA, CANCELADA
  type               String    @default("ORCAMENTO") // ORCAMENTO, AGENDAMENTO
  warrantyType       String    @default("NAO_SE_APLICA") // NAO_SE_APLICA, GARANTIA_LOJA, GARANTIA_FABRICA
  travelCost         String?
  discountCost       String?
  nfNumber           String?
  nfValue            String?
  purchaseDate       String?
  retailerName       String?
  cnpj               String?
  authorizedCode     String?
  guarantor          String?
  additionalNotes    String?
  totalAmount        Float     @default(0.0)
  createdAt          DateTime  @default(now())
  visits             Visit[]
}

model Visit {
  id             String       @id @default(uuid())
  orderId        String
  order          ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date           String // YYYY-MM-DD
  period         String // MANHA, TARDE
  technicianName String
  status         String       @default("AGENDADA") // AGENDADA, EM_ROTA, EM_ANDAMENTO, AGUARDANDO_PECA, CONCLUIDA, CANCELADA
  notes          String?
  photos         String? // JSON stringified array of base64 or URLs
  signatureUrl   String? // Base64 string
  createdAt      DateTime     @default(now())
  partsUsed      PartUsed[]
}

model PartUsed {
  id       String  @id @default(uuid())
  visitId  String
  visit    Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  name     String
  code     String?
  price    Float
  quantity Int     @default(1)
}
